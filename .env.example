# Application Configuration
APP_NAME=AI_CCTV_Attendance_System
ENV=development
LOG_LEVEL=INFO
DEBUG=true

# Database (Supabase PostgreSQL / Local SQLite)
# For Local SQLite:
DATABASE_URL=sqlite+aiosqlite:///./attendance.db

# For Supabase PostgreSQL (Replace with your Supabase credentials):
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-SUPABASE-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or Supabase Transaction Pooler (Port 6543):
# DATABASE_URL=postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-SUPABASE-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres

# Authentication & Security Secrets
JWT_SECRET=YOUR_SUPER_SECRET_JWT_KEY_CHANGE_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Camera & Video Processing Settings
CAMERA_PROCESSING_FPS=5.0
FACE_MATCH_THRESHOLD=0.55
MIN_CONFIRMATION_FRAMES=3
DETECTION_INTERVAL=1

# Attendance Timing Policies (24-hour HH:MM format)
ATTENDANCE_START_TIME=08:00
LATE_AFTER_TIME=09:15
ATTENDANCE_CUTOFF_TIME=17:00
TIMEZONE=Asia/Kolkata

# Data Retention & Storage Policy (Days)
UNKNOWN_FACE_RETENTION_DAYS=7
SNAPSHOT_RETENTION_DAYS=30
RECOGNITION_EVENT_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=90

# Media Storage Directories
STORAGE_DIR=./storage
